"lines": [
{
"text": "Deniz kabuğunda neden deniz sesi var?",
"start": 0.04,
"end": 1.745
},
{
"text": "Bakın, sahilde bir kabuk bulup kulağına tutuyorsun: içinde dalgalar!",
"start": 1.953,
"end": 5.253
},
{
"text": "Balıkçı amca gülüyor: \"İçinde deniz kalmış!\"",
"start": 5.461,
"end": 8.184
},
{
"text": "Daha büyük bir kabuk buluyorsun: bu sefer koca bir okyanus.",
"start": 8.392,
"end": 11.224
},
{
"text": "Sonra amcanın boş bardağını kulağına tutuyorsun: yine deniz!",
"start": 11.432,
"end": 14.452
},
{
"text": "Çünkü o ses denizden gelmiyor: kabuk, etrafındaki uğultuyu içinde çınlatıp büyütüyor.",
"start": 14.66,
"end": 19.199
},
{
"text": "Tıpkı boş şişeye üfleyince çıkan ses gibi: her boşluk bazı sesleri güçlendirir.",
"start": 19.407,
"end": 23.264
},
{
"text": "Hiç sesin olmadığı bir odada kabuk da susar.",
"start": 23.472,
"end": 25.594
},
{
"text": "Yani dinlediğin deniz değil, etrafındaki dünya.",
"start": 25.802,
"end": 28.482
},
{
"text": "Ama sen yine de kabuğu kulağına tutuyorsun.",
"start": 28.69,
"end": 30.909
}
],
"duration": 31.117,
