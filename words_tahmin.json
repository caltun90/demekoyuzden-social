"lines": [
{
"text": "Ayağın neden uyuşur?",
"start": 0.038,
"end": 0.994
},
{
"text": "Bakın, yer sofrasında bir saattir ayağının üstünde oturuyorsun.",
"start": 1.194,
"end": 4.229
},
{
"text": "Çay almaya kalkıyorsun: ayağın sanki yerinde yok.",
"start": 4.429,
"end": 7.195
},
{
"text": "Deden gülüyor: \"Ayağın uyuşmuş!\"",
"start": 7.395,
"end": 9.175
},
{
"text": "Bir adım atıyorsun: binlerce iğne batıyor.",
"start": 9.375,
"end": 11.709
},
{
"text": "Bir adım daha: bacağın lastik gibi bükülüyor ve halının ortasına yığılıyorsun.",
"start": 11.909,
"end": 16.084
},
{
"text": "Çünkü sorun ayağında değil: üstüne oturunca oraya giden sinir sıkıştı.",
"start": 16.284,
"end": 20.857
},
{
"text": "Tıpkı üstüne basılan hortum gibi, sinyal geçemiyor.",
"start": 21.057,
"end": 23.539
},
{
"text": "Kalkınca sinir yeniden çalışmaya başlıyor ve bir süre karmakarışık sinyal yolluyor.",
"start": 23.739,
"end": 28.03
},
{
"text": "Beynin de bu karmaşayı iğne batması sanıyor.",
"start": 28.23,
"end": 30.495
},
{
"text": "Geçince de gidip yine aynı ayağının üstüne oturuyorsun.",
"start": 30.695,
"end": 33.075
}
],
"duration": 33.275
}